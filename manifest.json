{
  "name": "ml-compute",
  "version": "0.1.13",
  "core": {
    "type": "docker",
    "display_name": "ML Compute",
    "description": "Orchestrateur Ray pour training ML et inférence GPU. Ray head node sur Soma, workers sur OnyxPoint (GPU T1000), Glia (CPU), Axon (CPU+Grobid).",
    "status": "dev",
    "brain_area": "cortex-visuel",
    "routing": {
      "host": "0.0.0.0",
      "port": 9469,
      "protocol": "http"
    }
  },
  "heart": {
    "deployment": {
      "target_host": "OnyxSoma",
      "platform": "linux"
    },
    "lifecycle": {
      "run_mode": "service",
      "start_command": "python -m src.main"
    },
    "resources": {
      "memory_high": "2G",
      "memory_max": "4G",
      "cpus": "4"
    }
  },
  "forge": {
    "type": "docker",
    "development": {
      "dev_platform": "dendrite",
      "test_platform": "dendrite",
      "dev_status": "deployed",
      "progress_percent": 100
    },
    "repository": "VersoVet/ml-compute"
  },
  "dashboard": {
    "enabled": true,
    "page": "/",
    "icon": "cpu",
    "category": "infrastructure",
    "color": "#e74c3c"
  },
  "integration": {
    "redis": {
      "publish_status": true,
      "channel": "onyx:skill:status"
    },
    "sdk": {
      "min_version": "2.1.0"
    }
  }
}