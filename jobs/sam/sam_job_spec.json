{
  "id": "sam-inference",
  "name": "sam-inference",
  "type": "service",
  "priority": 75,
  "taskgroups": [
    {
      "name": "sam",
      "count": 1,
      "tasks": [
        {
          "name": "sam-inference",
          "driver": "docker",
          "config": {
            "image": "sam-inference:v1",
            "command": "python3",
            "args": ["/app/sam_server.py"]
          },
          "mounts": [
            {
              "type": "bind",
              "target": "/app",
              "source": "/opt/onyx/skills/ml-compute/jobs/sam"
            },
            {
              "type": "bind",
              "target": "/models",
              "source": "/mnt/ml-store/sam-models"
            }
          ],
          "resources": {
            "cpu": 4000,
            "memory": 12288,
            "device": [
              {
                "name": "nvidia/gpu",
                "count": 1
              }
            ]
          },
          "env": {
            "CUDA_VISIBLE_DEVICES": "0"
          }
        }
      ]
    }
  ]
}
