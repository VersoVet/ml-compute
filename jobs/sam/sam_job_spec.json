{
  "id": "sam-inference",
  "name": "sam-inference",
  "type": "service",
  "priority": 75,
  "taskgroups": [
    {
      "name": "sam",
      "count": 1,
      "tasks": [
        {
          "name": "sam-inference",
          "driver": "docker",
          "config": {
            "image": "pytorch/pytorch:2.1-cuda12.1-runtime-ubuntu22.04",
            "command": "python",
            "args": ["-c", "import torch; print(f'CUDA: {torch.cuda.is_available()}'); print(f'GPUs: {torch.cuda.device_count()}'); import sys; sys.stdout.flush(); import time; time.sleep(3600)"]
          },
          "resources": {
            "cpu": 4000,
            "memory": 12288,
            "device": [
              {
                "name": "nvidia/gpu",
                "count": 1
              }
            ]
          },
          "env": {
            "CUDA_VISIBLE_DEVICES": "0"
          }
        }
      ]
    }
  ]
}
