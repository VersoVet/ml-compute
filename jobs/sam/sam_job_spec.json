{
  "id": "sam-inference",
  "name": "sam-inference",
  "type": "service",
  "priority": 75,
  "taskgroups": [
    {
      "name": "sam",
      "count": 1,
      "tasks": [
        {
          "name": "sam-inference",
          "driver": "docker",
          "config": {
            "image": "ubuntu:22.04",
            "command": "/bin/bash",
            "args": ["-c", "echo 'GPU Test Container'; nvidia-smi 2>/dev/null || echo 'NVIDIA GPU not available'; sleep 3600"]
          },
          "resources": {
            "cpu": 4000,
            "memory": 12288,
            "device": [
              {
                "name": "nvidia/gpu",
                "count": 1
              }
            ]
          },
          "env": {
            "CUDA_VISIBLE_DEVICES": "0"
          }
        }
      ]
    }
  ]
}
