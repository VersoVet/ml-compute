{
  "id": "sam-inference",
  "name": "sam-inference",
  "type": "service",
  "priority": 75,
  "taskgroups": [
    {
      "name": "sam",
      "count": 1,
      "tasks": [
        {
          "name": "sam-inference",
          "driver": "docker",
          "config": {
            "image": "pytorch/pytorch:2.1-cuda12.1-runtime-ubuntu22.04",
            "command": "python",
            "args": ["-c", "import torch; print(f'CUDA: {torch.cuda.is_available()}'); import sys; sys.stdout.flush(); import time; time.sleep(3600)"]
          },
          "resources": {
            "cpu": 2000,
            "memory": 4096,
            "devices": [
              {
                "name": "gpu",
                "count": 1
              }
            ]
          }
        }
      ]
    }
  ]
}
